# DemoMaker Sample Environment Configuration
# -----------------------------------------
# This file contains all possible environment variables that can be used
# to configure the DemoMaker application. Copy this file to '.env' and
# customize the values according to your needs.

# ===========================================
# AI Service Configuration
# ===========================================

# OpenAI Configuration
# -------------------
# Your OpenAI API key for accessing the OpenAI API services
OPENAI_API_KEY=your_openai_api_key_here
# Optional: Specify a different OpenAI API base URL if needed (e.g., Azure OpenAI)
OPENAI_API_BASE=https://api.openai.com/v1
# Optional: OpenAI organization ID if you belong to multiple organizations
OPENAI_ORG_ID=

# Azure OpenAI Configuration (if using Azure instead of OpenAI directly)
# -------------------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2023-05-15
AZURE_OPENAI_DEPLOYMENT_NAME=

# HuggingFace Configuration (for local models)
# -------------------
# Model paths or HuggingFace model IDs
HUGGINGFACE_TOKEN=
SCRIPT_GENERATION_MODEL=gpt2
NARRATION_GENERATION_MODEL=gpt2

# ===========================================
# Media Processing Configuration
# ===========================================

# Text-to-Speech Configuration
# -------------------
# Choose the TTS service to use: 'gtts' (Google), 'pyttsx3' (Local), or 'azure' (Azure Speech Service)
TTS_SERVICE=gtts
# Voice options for selected TTS provider (where applicable)
TTS_VOICE=en-US
# Speed rate for TTS (1.0 = normal speed)
TTS_SPEED=1.0

# Azure Speech Service (if using Azure TTS)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Video Generation Configuration
# -------------------
# Video resolution (width x height)
VIDEO_RESOLUTION=1920x1080
# Video framerate
VIDEO_FRAMERATE=30
# Video codec to use
VIDEO_CODEC=h264
# Default output format
VIDEO_FORMAT=mp4

# ===========================================
# Application Configuration
# ===========================================

# General Settings
# -------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Temp directory for working files
TEMP_DIR=/tmp/demo_maker
# Output directory for final videos
OUTPUT_DIR=./output
# Enable/disable caching of generated assets (0=off, 1=on)
ENABLE_CACHING=1
# Max cache size in MB
MAX_CACHE_SIZE=1024

# Performance Settings
# -------------------
# Number of worker processes to use for video generation
WORKER_COUNT=2
# Enable/disable GPU acceleration if available (0=off, 1=on)
USE_GPU=0

# Development Settings
# -------------------
# Set to 1 to enable development mode (additional logging, etc.)
DEV_MODE=0
# Enable profiling for performance analysis (0=off, 1=on)
ENABLE_PROFILING=0
